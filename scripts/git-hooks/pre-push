#!/usr/bin/env bash
# pre-push — единый локальный quality gate ДО CI (A4).
#
# Закрывает обход PreToolUse-хуков через Bash-запись (`cat > 04_synthesis/x.md`):
# хуки Claude Code видят только Write/Edit, а этот гейт — любой коммит перед push.
# Та же детерминированная команда, что запускается в CI.
#
# Установка (один раз в клоне):
#   git config core.hooksPath scripts/git-hooks
#
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

pnpm kb:check
