{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ushibu-nogami-hq.vercel.app/assets/data/operations.schema.json",
  "title": "Контракт оперативного штаба",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "matches", "training", "maps", "opponents"],
  "properties": {
    "meta": { "$ref": "#/$defs/meta" },
    "matches": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/match" } },
    "training": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/training" } },
    "maps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/map" } },
    "opponents": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/opponent" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "nonEmpty": { "type": "string", "pattern": "\\S" },
    "date": { "type": "string", "format": "date" },
    "confidence": { "enum": ["high", "medium", "low"] },
    "card": {
      "oneOf": [
        { "$ref": "#/$defs/fact" },
        { "$ref": "#/$defs/projection" },
        { "$ref": "#/$defs/decision" },
        { "$ref": "#/$defs/unknown" },
        { "$ref": "#/$defs/action" }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "body", "source", "sourceLabel", "asOf", "confidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "fact" },
        "title": { "$ref": "#/$defs/nonEmpty" }, "body": { "$ref": "#/$defs/nonEmpty" },
        "source": { "$ref": "#/$defs/nonEmpty" }, "sourceLabel": { "$ref": "#/$defs/nonEmpty" },
        "asOf": { "$ref": "#/$defs/date" }, "confidence": { "$ref": "#/$defs/confidence" }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "body", "source", "sourceLabel", "asOf", "confidence", "dataThrough", "sample", "caveat"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "projection" },
        "title": { "$ref": "#/$defs/nonEmpty" }, "body": { "$ref": "#/$defs/nonEmpty" },
        "source": { "$ref": "#/$defs/nonEmpty" }, "sourceLabel": { "$ref": "#/$defs/nonEmpty" },
        "asOf": { "$ref": "#/$defs/date" }, "confidence": { "$ref": "#/$defs/confidence" },
        "dataThrough": { "$ref": "#/$defs/date" }, "sample": { "$ref": "#/$defs/nonEmpty" },
        "caveat": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "body", "owner", "decidedAt", "rationale", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "decision" },
        "title": { "$ref": "#/$defs/nonEmpty" }, "body": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" }, "decidedAt": { "$ref": "#/$defs/date" },
        "rationale": { "$ref": "#/$defs/nonEmpty" },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "body", "blocking", "owner", "closeWith", "dueAt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "unknown" },
        "title": { "$ref": "#/$defs/nonEmpty" }, "body": { "$ref": "#/$defs/nonEmpty" },
        "blocking": { "type": "boolean" }, "owner": { "$ref": "#/$defs/nonEmpty" },
        "closeWith": { "$ref": "#/$defs/nonEmpty" }, "dueAt": { "$ref": "#/$defs/date" }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "body", "owner", "dueAt", "verifyWith", "dependsOn"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "type": { "const": "action" },
        "title": { "$ref": "#/$defs/nonEmpty" }, "body": { "$ref": "#/$defs/nonEmpty" },
        "owner": { "$ref": "#/$defs/nonEmpty" }, "dueAt": { "$ref": "#/$defs/date" },
        "verifyWith": { "$ref": "#/$defs/nonEmpty" },
        "dependsOn": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "title", "team", "snapshotAsOf", "methodology"],
      "properties": {
        "schemaVersion": { "const": 1 }, "title": { "$ref": "#/$defs/nonEmpty" },
        "team": { "$ref": "#/$defs/nonEmpty" }, "snapshotAsOf": { "$ref": "#/$defs/date" },
        "methodology": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "date", "opponentId", "opponent", "cards"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "date": { "$ref": "#/$defs/date" },
        "opponentId": { "$ref": "#/$defs/id" }, "opponent": { "$ref": "#/$defs/nonEmpty" },
        "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } }
      }
    },
    "training": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "mapId", "map", "date", "cards"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "mapId": { "$ref": "#/$defs/id" },
        "map": { "$ref": "#/$defs/nonEmpty" }, "date": { "$ref": "#/$defs/date" },
        "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } }
      }
    },
    "map": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "protocol", "cards"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" },
        "protocol": { "type": "null" },
        "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } }
      }
    },
    "opponent": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "matchId", "matchDate", "cards"],
      "properties": {
        "id": { "$ref": "#/$defs/id" }, "name": { "$ref": "#/$defs/nonEmpty" },
        "matchId": { "$ref": "#/$defs/id" }, "matchDate": { "$ref": "#/$defs/date" },
        "cards": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/card" } }
      }
    }
  }
}
